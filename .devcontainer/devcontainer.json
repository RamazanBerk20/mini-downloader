{
  "name": "Mini Downloader Native (Ubuntu 22.04)",
  "build": {
    "dockerfile": "../Dockerfile",
    "context": ".."
  },
  "remoteUser": "vscode",
  "workspaceFolder": "/workspaces/mini-downloader",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/mini-downloader,type=bind,consistency=cached",
  "overrideCommand": true,
  "postCreateCommand": "cargo fetch --locked",
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "Slint.slint",
        "tamasfe.even-better-toml",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker"
      ]
    }
  }
}
