export global Theme {
    in-out property <bool> dark: true;

    out property <color> canvas: dark ? #191919 : #f7f6f3;
    out property <color> surface: dark ? #212121 : #ffffff;
    out property <color> surface-2: dark ? #262626 : #f2f1ed;
    out property <color> border: dark ? #303030 : #eaeaea;
    out property <color> border-strong: dark ? #424242 : #dcdcd8;
    out property <color> text: dark ? #e6e4e0 : #2f3437;
    out property <color> strong: dark ? #f5f4f2 : #111111;
    out property <color> muted: dark ? #9b9a97 : #787774;
    out property <color> ink: dark ? #f2f1ee : #111111;
    out property <color> ink-fg: dark ? #191919 : #ffffff;
    out property <color> ink-hover: dark ? #deddd9 : #2b2b2b;
    out property <color> ink-pressed: dark ? #c5c3bd : #444444;
    out property <color> surface-pressed: dark ? #3a3a3a : #deddd8;
    out property <color> active-bg: dark ? #273746 : #e1f3fe;
    out property <color> active-fg: dark ? #86bdec : #1f6c9f;
    out property <color> complete-bg: dark ? #26382a : #edf3ec;
    out property <color> complete-fg: dark ? #84cb8e : #346538;
    out property <color> error-bg: dark ? #45282a : #fdebec;
    out property <color> error-fg: dark ? #ed9f9f : #9f2f2d;
    out property <color> paused-bg: dark ? #403823 : #fbf3db;
    out property <color> paused-fg: dark ? #d9bd70 : #956400;
    out property <color> queued-bg: dark ? #2b2b2b : #efefee;
    out property <color> queued-fg: dark ? #a6a5a2 : #6b6b69;
}

export component AppIcon inherits Path {
    in property <string> name;
    in property <brush> color: Theme.muted;

    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    fill: transparent;
    stroke: root.color;
    stroke-width: 1.75px;
    stroke-line-cap: LineCap.round;
    stroke-line-join: LineJoin.round;
    commands: name == "add" ? "M12 5 L12 19 M5 12 L19 12" :
        name == "heart" ? "M12 20 C10.8 19.2 3 14.5 3 9.2 C3 6.5 5 4.5 7.7 4.5 C9.4 4.5 11 5.4 12 6.8 C13 5.4 14.6 4.5 16.3 4.5 C19 4.5 21 6.5 21 9.2 C21 14.5 13.2 19.2 12 20 Z" :
        name == "close" ? "M6 6 L18 18 M18 6 L6 18" :
        // Window buttons (the custom title bar in main-window.slint).
        name == "minimize" ? "M6 13 L18 13" :
        name == "maximize" ? "M6 6 L18 6 L18 18 L6 18 Z" :
        name == "restore" ? "M5 9 L15 9 L15 19 L5 19 Z M9 9 L9 5 L19 5 L19 15 L15 15" :
        name == "file" ? "M6 3 L14 3 L18 7 L18 21 L6 21 Z M14 3 L14 7 L18 7" :
        name == "video" ? "M5 6 L14 6 A2 2 0 0 1 16 8 L16 16 A2 2 0 0 1 14 18 L5 18 A2 2 0 0 1 3 16 L3 8 A2 2 0 0 1 5 6 Z M16 10 L21 7 L21 17 L16 14 Z" :
        name == "link" ? "M9.5 14.5 L14.5 9.5 M11 7 L12 6 A4 4 0 0 1 18 12 L17 13 M13 17 L12 18 A4 4 0 0 1 6 12 L7 11" :
        name == "gear" ? "M15.2 12 A3.2 3.2 0 1 1 8.8 12 A3.2 3.2 0 1 1 15.2 12 M12 3 L12 5.2 M12 18.8 L12 21 M3 12 L5.2 12 M18.8 12 L21 12 M5.6 5.6 L7.2 7.2 M16.8 16.8 L18.4 18.4 M18.4 5.6 L16.8 7.2 M7.2 16.8 L5.6 18.4" :
        name == "gauge" ? "M4 15 A8 8 0 0 1 20 15 M12 15 L16.5 11 M13.1 15 A1.1 1.1 0 1 1 10.9 15 A1.1 1.1 0 1 1 13.1 15" :
        name == "play" ? "M8 5.5 L8 18.5 L18.5 12 Z" :
        name == "pause" ? "M9 5 L9 19 M15 5 L15 19" :
        name == "folder" ? "M3 7 A2 2 0 0 1 5 5 L8.5 5 L10.5 7 L19 7 A2 2 0 0 1 21 9 L21 17 A2 2 0 0 1 19 19 L5 19 A2 2 0 0 1 3 17 Z" :
        name == "retry" ? "M20 12 A8 8 0 1 1 17.7 6.4 M20 4 L20 8 L16 8" :
        name == "trash" ? "M4 7 L20 7 M9 7 L9 5 A1 1 0 0 1 10 4 L14 4 A1 1 0 0 1 15 5 L15 7 M6.5 7 L7.5 19.5 A1 1 0 0 0 8.5 20.4 L15.5 20.4 A1 1 0 0 0 16.5 19.5 L18 7" :
        name == "search" ? "M17 11 A6 6 0 1 1 5 11 A6 6 0 1 1 17 11 M15.4 15.4 L20 20" :
        name == "download" ? "M12 4 L12 15 M7 11 L12 16 L17 11 M5 20 L19 20" :
        name == "magnet" ? "M6 4 L6 11 A6 6 0 0 0 18 11 L18 4 M6 8 L10 8 M14 8 L18 8" :
        name == "check" ? "M5 13 L9 17 L19 7" :
        name == "warning" ? "M12 4 L21 20 L3 20 Z M12 10 L12 14.5 M12 17.6 L12.01 17.6" :
        name == "inbox" ? "M4 13 L6.2 4.8 A2 2 0 0 1 8.1 3.3 L15.9 3.3 A2 2 0 0 1 17.8 4.8 L20 13 L20 18 A2 2 0 0 1 18 20 L6 20 A2 2 0 0 1 4 18 Z M4 13 L8.5 13 L9.7 15.2 L14.3 15.2 L15.5 13 L20 13" :
        name == "list" ? "M8 6 L21 6 M8 12 L21 12 M8 18 L21 18 M3.5 6 L3.51 6 M3.5 12 L3.51 12 M3.5 18 L3.51 18" :
        name == "clock" ? "M20 12 A8 8 0 1 1 4 12 A8 8 0 1 1 20 12 M12 8 L12 12.2 L14.8 14" :
        name == "help" ? "M20.5 12 A8.5 8.5 0 1 1 3.5 12 A8.5 8.5 0 1 1 20.5 12 M9.6 9.5 A2.4 2.4 0 0 1 14.2 10.4 C14.2 12 12 12.4 12 13.8 M12 17.2 L12.01 17.2" :
        name == "chevron-up" ? "M6 15 L12 9 L18 15" :
        name == "chevron-down" ? "M6 9 L12 15 L18 9" :
        name == "chevron-right" ? "M9 6 L15 12 L9 18" :
        // File-type glyphs (FileTile), same 24-grid and stroke as the rest.
        name == "ft-archive" ? "M6 3 L18 3 L18 21 L6 21 Z M11 3 L11 5 M13 5 L13 7 M11 7 L11 9 M13 9 L13 11 M10.5 12.5 L13.5 12.5 L13.5 16.5 L10.5 16.5 Z" :
        name == "ft-video" ? "M4 5 L20 5 L20 19 L4 19 Z M8 5 L8 19 M16 5 L16 19 M4 9.5 L8 9.5 M4 14.5 L8 14.5 M16 9.5 L20 9.5 M16 14.5 L20 14.5" :
        name == "ft-stream" ? "M5 5 L19 5 A2 2 0 0 1 21 7 L21 17 A2 2 0 0 1 19 19 L5 19 A2 2 0 0 1 3 17 L3 7 A2 2 0 0 1 5 5 Z M10 9 L15 12 L10 15 Z" :
        name == "ft-audio" ? "M9.5 17 L9.5 5.5 L19 3.5 L19 15 M9.5 9 L19 7 M9.5 17 A2.5 2.5 0 1 1 4.5 17 A2.5 2.5 0 1 1 9.5 17 M19 15 A2.5 2.5 0 1 1 14 15 A2.5 2.5 0 1 1 19 15" :
        name == "ft-image" ? "M4 5 L20 5 L20 19 L4 19 Z M4 16 L9 11 L13 15 L15.5 12.5 L20 17 M17 8.5 A1.5 1.5 0 1 1 14 8.5 A1.5 1.5 0 1 1 17 8.5" :
        name == "ft-document" ? "M6 3 L14 3 L18 7 L18 21 L6 21 Z M14 3 L14 7 L18 7 M9 11 L15 11 M9 14 L15 14 M9 17 L13 17" :
        name == "ft-pdf" ? "M6 3 L14 3 L18 7 L18 21 L6 21 Z M14 3 L14 7 L18 7 M9.5 18 L9.5 11 L12 11 A2 2 0 0 1 12 15 L9.5 15" :
        name == "ft-spreadsheet" ? "M4 4 L20 4 L20 20 L4 20 Z M4 9.5 L20 9.5 M4 15 L20 15 M10 4 L10 20" :
        name == "ft-presentation" ? "M3 4 L21 4 M5 4 L5 15 L19 15 L19 4 M12 15 L12 18 M8.5 21 L12 18 L15.5 21 M9 12 L9 10 M12 12 L12 7.5 M15 12 L15 9" :
        name == "ft-code" ? "M8.5 7 L3.5 12 L8.5 17 M15.5 7 L20.5 12 L15.5 17 M13.5 5 L10.5 19" :
        name == "ft-executable" ? "M3 5 L21 5 L21 19 L3 19 Z M3 9 L21 9 M7 12 L10 14.5 L7 17 M12.5 17 L16.5 17" :
        name == "ft-package" ? "M12 3 L20 7.5 L20 16.5 L12 21 L4 16.5 L4 7.5 Z M4 7.5 L12 12 L20 7.5 M12 12 L12 21 M8 5.25 L16 9.75" :
        name == "ft-disk-image" ? "M20 12 A8 8 0 1 1 4 12 A8 8 0 1 1 20 12 M14 12 A2 2 0 1 1 10 12 A2 2 0 1 1 14 12 M7.8 9.4 A5 5 0 0 1 9.4 7.8" :
        name == "ft-torrent" ? "M6 4 L6 11 A6 6 0 0 0 18 11 L18 4 M6 8 L10 8 M14 8 L18 8" :
        name == "ft-folder" ? "M3 7 A2 2 0 0 1 5 5 L8.5 5 L10.5 7 L19 7 A2 2 0 0 1 21 9 L21 17 A2 2 0 0 1 19 19 L5 19 A2 2 0 0 1 3 17 Z" :
        name == "ft-font" ? "M3 19 L8 5 L13 19 M5 14 L11 14 M20.5 11 L20.5 19 M20.5 15.5 A3 3 0 1 1 14.5 15.5 A3 3 0 1 1 20.5 15.5" :
        name == "ft-ebook" ? "M12 6 C10 4.5 6.5 4 3 4.5 L3 18.5 C6.5 18 10 18.5 12 20 C14 18.5 17.5 18 21 18.5 L21 4.5 C17.5 4 14 4.5 12 6 Z M12 6 L12 20" :
        name == "ft-subtitle" ? "M4 5 L20 5 L20 16 L13 16 L9 20 L9 16 L4 16 Z M7.5 9 L16.5 9 M7.5 12.5 L13.5 12.5" :
        name == "ft-data" ? "M19 6 A7 2.5 0 1 1 5 6 A7 2.5 0 1 1 19 6 M5 6 L5 18 A7 2.5 0 0 0 19 18 L19 6 M5 12 A7 2.5 0 0 0 19 12" :
        name == "ft-resolving" ? "M6 3 L14 3 L18 7 L18 21 L6 21 Z M14 3 L14 7 L18 7 M9 14 L9.01 14 M12 14 L12.01 14 M15 14 L15.01 14" :
        name == "ft-generic" ? "M6 3 L14 3 L18 7 L18 21 L6 21 Z M14 3 L14 7 L18 7" :
        "";
}

export component IconSlot inherits Rectangle {
    in property <string> name;
    in property <brush> icon-color: Theme.muted;
    in property <length> size: 16px;

    width: root.size;
    horizontal-stretch: 0;
    background: transparent;
    AppIcon {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: root.size;
        height: root.size;
        name: root.name;
        color: root.icon-color;
    }
}

// File-type tile colours: muted tints below the status pills' chroma, a
// light and a dark pair per category with the glyph at >= 4.5:1 on its tile.
export global FileTheme {
    pure public function tint(type: string) -> color {
        if type == "archive" { return Theme.dark ? #3b2f24 : #f8eee3; }
        if type == "video" { return Theme.dark ? #2e2840 : #efe9fd; }
        if type == "stream" { return Theme.dark ? #3f2b22 : #fdefe6; }
        if type == "audio" { return Theme.dark ? #3d2734 : #fbe9f1; }
        if type == "image" { return Theme.dark ? #1f3735 : #e4f4f1; }
        if type == "document" { return Theme.dark ? #24313f : #e6f0fa; }
        if type == "pdf" { return Theme.dark ? #402626 : #fdebeb; }
        if type == "spreadsheet" { return Theme.dark ? #233528 : #e8f4ea; }
        if type == "presentation" { return Theme.dark ? #3d321f : #fbf2df; }
        if type == "code" { return Theme.dark ? #1f3240 : #e3f2fa; }
        if type == "executable" { return Theme.dark ? #2f2f35 : #efeff2; }
        if type == "package" { return Theme.dark ? #2a3340 : #e9f0f8; }
        if type == "disk-image" { return Theme.dark ? #262b40 : #e8ecfc; }
        if type == "torrent" { return Theme.dark ? #3a2540 : #f6e8fa; }
        if type == "folder" { return Theme.dark ? #3a3426 : #f7f1e2; }
        if type == "font" { return Theme.dark ? #302b36 : #f0edf4; }
        if type == "ebook" { return Theme.dark ? #33341f : #f3f4e2; }
        if type == "subtitle" { return Theme.dark ? #38351f : #f7f4dd; }
        if type == "data" { return Theme.dark ? #22333a : #e6f1f3; }
        return Theme.surface-2;
    }
    pure public function ink(type: string) -> color {
        if type == "archive" { return Theme.dark ? #e0b07e : #8a5216; }
        if type == "video" { return Theme.dark ? #b9a5f0 : #5b3fb0; }
        if type == "stream" { return Theme.dark ? #f0b08f : #a4481c; }
        if type == "audio" { return Theme.dark ? #eba1c4 : #9c2f62; }
        if type == "image" { return Theme.dark ? #7fd0c4 : #1f6d63; }
        if type == "document" { return Theme.dark ? #95bde6 : #285f93; }
        if type == "pdf" { return Theme.dark ? #f0a3a3 : #a12f2f; }
        if type == "spreadsheet" { return Theme.dark ? #92cf9d : #2f6b3b; }
        if type == "presentation" { return Theme.dark ? #e8c27a : #85580b; }
        if type == "code" { return Theme.dark ? #8cc7e8 : #1d5f80; }
        if type == "executable" { return Theme.dark ? #b4b4c2 : #4a4a5a; }
        if type == "package" { return Theme.dark ? #a3c0e3 : #2f557f; }
        if type == "disk-image" { return Theme.dark ? #9fb0f0 : #34449c; }
        if type == "torrent" { return Theme.dark ? #d79ae6 : #7d2e93; }
        if type == "folder" { return Theme.dark ? #dcc48e : #735819; }
        if type == "font" { return Theme.dark ? #bcb0cc : #5a4c6e; }
        if type == "ebook" { return Theme.dark ? #c9cc84 : #5c5e1b; }
        if type == "subtitle" { return Theme.dark ? #d8cf7c : #665d12; }
        if type == "data" { return Theme.dark ? #9cc4cc : #2d5f68; }
        return Theme.muted;
    }
}

// A rounded tile tinted for the file's type, with a stroked glyph and an
// optional item count. `label` is its spoken name.
export component FileTile inherits Rectangle {
    in property <string> type: "generic";
    in property <string> label;
    in property <string> count;
    accessible-role: image;
    accessible-label: root.label;

    width: 26px;
    height: 26px;
    horizontal-stretch: 0;
    border-radius: 7px;
    background: FileTheme.tint(root.type);
    border-width: root.type == "resolving" ? 1px : 0px;
    border-color: Theme.border-strong;
    AppIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        name: "ft-" + root.type;
        color: FileTheme.ink(root.type);
    }
    if root.count != "": Rectangle {
        x: parent.width - self.width / 2 - 3px;
        y: -4px;
        width: max(13px, count-text.preferred-width + 6px);
        height: 12px;
        border-radius: 6px;
        background: FileTheme.ink(root.type);
        count-text := Text {
            width: parent.width;
            height: parent.height;
            text: root.count;
            color: FileTheme.tint(root.type);
            font-family: "Noto Sans Mono";
            font-size: 8px;
            font-weight: 700;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}

export component UiButton inherits Rectangle {
    in property <string> text;
    in property <string> icon: "";
    in property <bool> primary: false;
    in property <bool> ghost: false;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    in property <bool> compact: false;
    callback clicked;
    forward-focus: focus;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.text;
    accessible-action-default => { if root.enabled { touch.clicked(); } }

    min-width: button-layout.min-width;
    preferred-width: button-layout.min-width;
    height: root.compact ? 34px : 38px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 7px;
    border-width: focus.has-focus ? 2px : root.ghost && !touch.has-hover && !touch.pressed ? 0px : 1px;
    border-color: focus.has-focus ? Theme.active-fg : root.primary ? (touch.pressed ? Theme.ink-pressed : touch.has-hover ? Theme.ink-hover : Theme.ink) :
        touch.pressed ? Theme.border-strong : Theme.border;
    background: !root.enabled ? Theme.surface-2 : root.primary ?
        (touch.pressed ? Theme.ink-pressed : touch.has-hover ? Theme.ink-hover : Theme.ink) :
        touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-2 :
        root.ghost ? transparent : Theme.surface;
    opacity: root.enabled ? 1 : 0.55;
    animate background, border-color { duration: 90ms; easing: ease-out; }

    button-layout := HorizontalLayout {
        y: touch.pressed ? 1px : 0px;
        height: parent.height - self.y;
        padding-left: root.compact ? 10px : 12px;
        padding-right: root.compact ? 10px : 12px;
        spacing: root.compact ? 6px : 7px;
        alignment: center;
        if root.icon != "": IconSlot {
            name: root.icon;
            size: root.compact ? 14px : 16px;
            icon-color: root.primary ? Theme.ink-fg : root.danger ? Theme.error-fg : Theme.muted;
        }
        Text {
            text: root.text;
            color: root.primary ? Theme.ink-fg : root.danger ? Theme.error-fg : Theme.text;
            font-size: root.compact ? 12px : 13px;
            font-weight: root.primary ? 600 : 400;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component IconButton inherits Rectangle {
    in property <string> icon;
    in property <string> label: icon;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked;
    forward-focus: focus;
    accessible-role: button;
    accessible-enabled: root.enabled;
    accessible-label: root.label;
    accessible-action-default => { if root.enabled { touch.clicked(); } }

    width: 32px;
    height: 32px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 7px;
    border-width: focus.has-focus ? 2px : touch.has-hover || touch.pressed ? 1px : 0px;
    border-color: focus.has-focus ? Theme.active-fg : touch.pressed ? Theme.border-strong : Theme.border;
    background: touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-2 : transparent;
    opacity: root.enabled ? 1 : 0.45;
    animate background, border-color { duration: 90ms; easing: ease-out; }
    AppIcon {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2 + (touch.pressed ? 1px : 0px);
        name: root.icon;
        width: 17px;
        height: 17px;
        color: root.danger && touch.has-hover ? Theme.error-fg : touch.has-hover ? Theme.strong : Theme.muted;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }
    // Keep the observer above the button's event-consuming TouchArea. Slint's
    // generated TooltipArea uses forward-and-observe input handling; placing it
    // behind `touch` prevents it from ever seeing hover events.
    Tooltip {
        text: @markdown("\{root.label}");
    }
}

export component UiField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    in property <string> icon: "";
    in property <bool> enabled: true;
    out property <bool> input-focused: input.has-focus;
    callback accepted;
    callback edited;
    callback committed;
    callback focus-input;

    forward-focus: input;

    min-width: 120px;
    height: 38px;
    vertical-stretch: 0;
    border-radius: 7px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.border-strong : Theme.border;
    background: Theme.surface;
    clip: true;

    if root.icon != "": AppIcon {
        x: 10px;
        y: (parent.height - self.height) / 2;
        width: 16px;
        height: 16px;
        name: root.icon;
        color: Theme.muted;
    }
    Text {
        x: root.icon == "" ? 11px : 34px;
        width: parent.width - self.x - 10px;
        height: parent.height;
        text: root.text == "" ? root.placeholder : "";
        color: Theme.muted;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    input := TextInput {
        x: root.icon == "" ? 11px : 34px;
        width: parent.width - self.x - 10px;
        height: parent.height;
        text <=> root.text;
        enabled: root.enabled;
        single-line: true;
        vertical-alignment: center;
        color: Theme.text;
        font-size: 13px;
        selection-background-color: Theme.active-fg;
        selection-foreground-color: Theme.canvas;
        accepted => { root.accepted(); root.committed(); }
        edited => { root.edited(); }
        changed has-focus => {
            if (!self.has-focus) {
                root.committed();
            }
        }
    }
    focus-input => { input.focus(); }
}

export component UiTextArea inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder;
    callback edited;

    border-radius: 8px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.border-strong : Theme.border;
    background: Theme.surface;
    clip: true;
    Text {
        x: 11px;
        y: 9px;
        width: parent.width - 22px;
        text: root.text == "" ? root.placeholder : "";
        color: Theme.muted;
        font-size: 13px;
        wrap: word-wrap;
    }
    input := TextInput {
        x: 11px;
        y: 8px;
        width: parent.width - 22px;
        height: parent.height - 16px;
        text <=> root.text;
        color: Theme.text;
        font-size: 13px;
        wrap: word-wrap;
        selection-background-color: Theme.active-fg;
        selection-foreground-color: Theme.canvas;
        edited => { root.edited(); }
    }
}

export component NavItem inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    in property <string> count: "";
    in property <bool> selected: false;
    callback clicked;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text + " " + root.count;
    accessible-action-default => { touch.clicked(); }

    height: 34px;
    vertical-stretch: 0;
    border-radius: 7px;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.active-fg;
    background: touch.pressed ? Theme.surface-pressed : root.selected || touch.has-hover ? Theme.surface-2 : transparent;
    animate background { duration: 90ms; easing: ease-out; }
    nav-layout := HorizontalLayout {
        y: touch.pressed ? 1px : 0px;
        height: parent.height - self.y;
        padding-left: 8px;
        padding-right: 8px;
        spacing: 9px;
        IconSlot { name: root.icon; size: 16px; icon-color: root.selected ? Theme.strong : Theme.muted; }
        Text { text: root.text; color: root.selected ? Theme.strong : Theme.text; font-size: 13px; font-weight: root.selected ? 600 : 400; horizontal-stretch: 1; overflow: elide; vertical-alignment: center; }
        Text { text: root.count; color: Theme.muted; font-family: "Noto Sans Mono"; font-size: 10px; horizontal-alignment: right; vertical-alignment: center; }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component UiCheckBox inherits Rectangle {
    in-out property <bool> checked: false;
    in property <string> text: "";
    in property <string> label: root.text;
    callback toggled(bool);
    forward-focus: focus;
    accessible-role: checkbox;
    accessible-label: root.label;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => { touch.clicked(); }

    min-height: 26px;
    min-width: 23px + check-label.preferred-width;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    background: transparent;
    check-indicator := Rectangle {
        x: 0px;
        y: (parent.height - self.height) / 2;
        width: 15px;
        height: 15px;
        border-radius: 3px;
        border-width: focus.has-focus ? 2px : 1px;
        border-color: focus.has-focus ? Theme.active-fg : root.checked ? (touch.pressed ? Theme.ink-pressed : touch.has-hover ? Theme.ink-hover : Theme.ink) : Theme.border-strong;
        background: root.checked ? (touch.pressed ? Theme.ink-pressed : touch.has-hover ? Theme.ink-hover : Theme.ink) :
            touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-2 : transparent;
        animate background, border-color { duration: 90ms; easing: ease-out; }
        if root.checked: AppIcon { x: 2px; y: 2px; width: 11px; height: 11px; name: "check"; color: Theme.ink-fg; }
    }
    check-label := Text {
        x: 23px;
        width: parent.width - self.x;
        height: parent.height;
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.checked = !root.checked; root.toggled(root.checked); }
    }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }
}

