export component SectionLabel inherits Text {
    text: "SECTION";
    color: Theme.muted;
    font-family: "Noto Sans Mono";
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.4px;
    vertical-alignment: center;
}

// One notice: errors in the error colours, information in the neutral ones.
export component NoticeBanner inherits Rectangle {
    in property <bool> error: true;
    in property <string> text;
    in property <string> label-close;
    callback dismiss;
    accessible-role: AccessibleRole.text;
    accessible-label: root.text;

    horizontal-stretch: 1;
    min-height: 34px;
    border-radius: 7px;
    background: root.error ? Theme.error-bg : Theme.active-bg;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 5px;
        spacing: 9px;
        IconSlot { name: root.error ? "warning" : "check"; size: 16px; icon-color: root.error ? Theme.error-fg : Theme.active-fg; }
        Text { text: root.text; color: root.error ? Theme.error-fg : Theme.active-fg; font-size: 12px; horizontal-stretch: 1; vertical-alignment: center; overflow: elide; }
        Rectangle {
            width: 28px;
            horizontal-stretch: 0;
            background: transparent;
            IconButton {
                y: (parent.height - self.height) / 2;
                icon: "close";
                label: root.label-close;
                danger: root.error;
                width: 28px;
                height: 28px;
                clicked => { root.dismiss(); }
            }
        }
    }
}

// Empty title-bar space: press and move drags the window (handed to the
// compositor through winit), a double-click toggles maximise. Controls
// placed above it keep their own presses.
export component WindowDragArea inherits TouchArea {
    callback drag();
    callback toggle-maximized();
    // One drag per press: after drag_window the compositor owns the pointer.
    property <bool> armed;
    pointer-event(event) => {
        if event.button == PointerEventButton.left {
            self.armed = event.kind == PointerEventKind.down;
        }
    }
    moved => {
        if self.armed && (abs(self.mouse-x - self.pressed-x) > 3px || abs(self.mouse-y - self.pressed-y) > 3px) {
            self.armed = false;
            root.drag();
        }
    }
    double-clicked => { root.toggle-maximized(); }
}

// Minimise, maximise/restore, close; mirrored with the layout.
export component WindowButtons inherits HorizontalLayout {
    in property <bool> maximized;
    in property <bool> rtl;
    in property <string> label-minimize;
    in property <string> label-maximize;
    in property <string> label-restore;
    in property <string> label-close;
    callback minimize();
    callback toggle-maximized();
    callback close();
    spacing: 2px;
    // Set a little apart from the app's own tools.
    padding-left: root.rtl ? 0px : 8px;
    padding-right: root.rtl ? 8px : 0px;
    if root.rtl: IconButton { icon: "close"; label: root.label-close; danger: true; clicked => { root.close(); } }
    if root.rtl: IconButton { icon: root.maximized ? "restore" : "maximize"; label: root.maximized ? root.label-restore : root.label-maximize; clicked => { root.toggle-maximized(); } }
    IconButton { icon: "minimize"; label: root.label-minimize; clicked => { root.minimize(); } }
    if !root.rtl: IconButton { icon: root.maximized ? "restore" : "maximize"; label: root.maximized ? root.label-restore : root.label-maximize; clicked => { root.toggle-maximized(); } }
    if !root.rtl: IconButton { icon: "close"; label: root.label-close; danger: true; clicked => { root.close(); } }
}
