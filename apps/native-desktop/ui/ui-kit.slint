}

export component UiSlider inherits Rectangle {
    in-out property <int> value: 0;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> label: "";
    callback changed(int);
    forward-focus: focus;
    accessible-role: AccessibleRole.slider;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-set-value(v) => {
        if v.is-float() {
            root.value = max(root.minimum, min(root.maximum, Math.round(v.to-float())));
            root.changed(root.value);
        }
    }
    accessible-action-increment => {
        root.value = min(root.maximum, root.value + root.step);
        root.changed(root.value);
    }
    accessible-action-decrement => {
        root.value = max(root.minimum, root.value - root.step);
        root.changed(root.value);
    }

    height: 26px;
    vertical-stretch: 0;
    background: transparent;

    slider := TouchArea {
        mouse-cursor: pointer;

        function update-value() {
            root.value = max(root.minimum, min(root.maximum,
                Math.round(root.minimum + (root.maximum - root.minimum)
                    * max(0px, min(self.width - 14px, self.mouse-x - 7px))
                    / max(1px, self.width - 14px))));
        }

        Rectangle {
            x: 7px;
            y: (parent.height - self.height) / 2;
            width: parent.width - 14px;
            height: 4px;
            border-radius: 2px;
            background: Theme.border-strong;
            Rectangle {
                x: 0px;
                width: parent.width * (root.value - root.minimum) / max(1, root.maximum - root.minimum);
                height: parent.height;
                border-radius: parent.border-radius;
                background: Theme.strong;
            }
        }
        Rectangle {
            x: (parent.width - self.width) * (root.value - root.minimum) / max(1, root.maximum - root.minimum);
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            border-width: focus.has-focus ? 3px : 2px;
            border-color: focus.has-focus ? Theme.active-fg : Theme.strong;
            background: Theme.canvas;
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                focus.focus();
                self.update-value();
            } else if (event.kind == PointerEventKind.up) {
                root.changed(root.value);
            }
        }
        moved => { self.update-value(); }
    }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.RightArrow || event.text == Key.UpArrow {
                root.value = min(root.maximum, root.value + root.step);
                root.changed(root.value);
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.DownArrow {
                root.value = max(root.minimum, root.value - root.step);
                root.changed(root.value);
                return accept;
            }
            if event.text == Key.Home {
                root.value = root.minimum;
                root.changed(root.value);
                return accept;
            }
            if event.text == Key.End {
                root.value = root.maximum;
                root.changed(root.value);
                return accept;
            }
            return reject;
        }
    }
}

export component SettingsTab inherits Rectangle {
    in property <string> text;
