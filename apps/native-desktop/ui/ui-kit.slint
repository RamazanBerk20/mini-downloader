    function commit() {
        if (root.edit-text.is-float()) {
            root.value = max(root.minimum, min(root.maximum, root.edit-text.to-float()));
            root.changed(root.value);
        }
        root.edit-text = root.value;
    }

    width: 110px;
    height: 38px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 7px;
    border-width: 1px;
    border-color: input.has-focus ? Theme.border-strong : Theme.border;
    background: Theme.surface;
    clip: true;

    input := TextInput {
        x: 10px;
        width: parent.width - 20px;
        height: parent.height;
        text <=> root.edit-text;
        single-line: true;
        input-type: InputType.number;
        horizontal-alignment: right;
        vertical-alignment: center;
        color: Theme.text;
        font-family: "Noto Sans Mono";
        font-size: 12px;
        selection-background-color: Theme.active-fg;
        selection-foreground-color: Theme.canvas;
        accessible-label: root.label;
        accepted => { root.commit(); }
        changed has-focus => {
            if (!self.has-focus) {
                root.commit();
            }
        }
    }
}

export component UiSlider inherits Rectangle {
    in-out property <int> value: 0;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> label: "";
    callback changed(int);
    forward-focus: focus;
    accessible-role: AccessibleRole.slider;
    accessible-label: root.label;
    accessible-value: root.value;
    accessible-value-minimum: root.minimum;
    accessible-value-maximum: root.maximum;
    accessible-value-step: root.step;
    accessible-action-set-value(v) => {
        if v.is-float() {
            root.value = max(root.minimum, min(root.maximum, Math.round(v.to-float())));
            root.changed(root.value);
        }
    }
    accessible-action-increment => {
        root.value = min(root.maximum, root.value + root.step);
        root.changed(root.value);
    }
    accessible-action-decrement => {
        root.value = max(root.minimum, root.value - root.step);
        root.changed(root.value);
    }

    height: 26px;
    vertical-stretch: 0;
    background: transparent;

    slider := TouchArea {
        mouse-cursor: pointer;

        function update-value() {
            root.value = max(root.minimum, min(root.maximum,
                Math.round(root.minimum + (root.maximum - root.minimum) * self.mouse-x / self.width)));
        }

        Rectangle {
            x: 7px;
            y: (parent.height - self.height) / 2;
            width: parent.width - 14px;
            height: 4px;
            border-radius: 2px;
            background: Theme.border-strong;
            Rectangle {
                x: 0px;
                width: parent.width * (root.value - root.minimum) / max(1, root.maximum - root.minimum);
                height: parent.height;
                border-radius: parent.border-radius;
                background: Theme.strong;
            }
        }
        Rectangle {
            x: 1px + (parent.width - self.width - 2px) * (root.value - root.minimum) / max(1, root.maximum - root.minimum);
            y: (parent.height - self.height) / 2;
            width: 14px;
            height: 14px;
            border-radius: 7px;
            border-width: focus.has-focus ? 3px : 2px;
            border-color: focus.has-focus ? Theme.active-fg : Theme.strong;
            background: Theme.canvas;
        }
        pointer-event(event) => {
            if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                focus.focus();
                self.update-value();
            } else if (event.kind == PointerEventKind.up) {
                root.changed(root.value);
            }
        }
        moved => { self.update-value(); }
    }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.RightArrow || event.text == Key.UpArrow {
                root.value = min(root.maximum, root.value + root.step);
                root.changed(root.value);
                return accept;
            }
            if event.text == Key.LeftArrow || event.text == Key.DownArrow {
                root.value = max(root.minimum, root.value - root.step);
                root.changed(root.value);
                return accept;
            }
            if event.text == Key.Home {
                root.value = root.minimum;
                root.changed(root.value);
                return accept;
            }
            if event.text == Key.End {
                root.value = root.maximum;
                root.changed(root.value);
                return accept;
            }
            return reject;
        }
    }
}

export component SettingsTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-action-default => { touch.clicked(); }

    height: 31px;
    min-width: 54px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 6px;
    border-width: focus.has-focus ? 2px : root.selected ? 1px : 0px;
    border-color: focus.has-focus ? Theme.active-fg : root.selected ? (touch.pressed ? Theme.ink-pressed : touch.has-hover ? Theme.ink-hover : Theme.ink) :
        touch.pressed ? Theme.border-strong : transparent;
    background: root.selected ? (touch.pressed ? Theme.ink-pressed : touch.has-hover ? Theme.ink-hover : Theme.ink) :
        touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-2 : transparent;
    animate background, border-color { duration: 90ms; easing: ease-out; }
    Text {
        x: 5px;
        y: touch.pressed ? 1px : 0px;
        width: parent.width - 10px;
        height: parent.height - self.y;
        text: root.text;
        color: root.selected ? Theme.ink-fg : touch.has-hover ? Theme.strong : Theme.muted;
        font-size: 10px;
        font-weight: root.selected ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component UiStepper inherits Rectangle {
    in-out property <int> value: 0;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> label: "";
    callback changed(int);

    width: 116px;
    height: 38px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;
    clip: true;

    Rectangle {
        x: 33px;
        width: 1px;
        height: parent.height;
        background: Theme.border;
    }
    Rectangle {
        x: parent.width - 34px;
        width: 1px;
        height: parent.height;
        background: Theme.border;
    }
    Text {
        x: 34px;
        width: parent.width - 68px;
        height: parent.height;
        text: root.value;
        color: Theme.text;
        font-family: "Noto Sans Mono";
        font-size: 11px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        x: 0px;
        width: 33px;
        height: parent.height;
        background: decrement.pressed ? Theme.surface-pressed : decrement.has-hover ? Theme.surface-2 : transparent;
        animate background { duration: 90ms; easing: ease-out; }
        Text { y: decrement.pressed ? 1px : 0px; width: parent.width; height: parent.height - self.y; text: "−"; color: Theme.muted; font-size: 16px; horizontal-alignment: center; vertical-alignment: center; }
        decrement := TouchArea {
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: "Decrease " + root.label;
            clicked => {
                root.value = max(root.minimum, root.value - root.step);
                root.changed(root.value);
            }
        }
    }
    Rectangle {
        x: parent.width - 33px;
        width: 33px;
        height: parent.height;
        background: increment.pressed ? Theme.surface-pressed : increment.has-hover ? Theme.surface-2 : transparent;
        animate background { duration: 90ms; easing: ease-out; }
        Text { y: increment.pressed ? 1px : 0px; width: parent.width; height: parent.height - self.y; text: "+"; color: Theme.muted; font-size: 15px; horizontal-alignment: center; vertical-alignment: center; }
        increment := TouchArea {
            mouse-cursor: pointer;
            accessible-role: button;
            accessible-label: "Increase " + root.label;
            clicked => {
                root.value = min(root.maximum, root.value + root.step);
                root.changed(root.value);
            }
        }
    }
}

export component OnboardCard inherits Rectangle {
    in property <string> text;
    in property <string> icon;
    callback clicked;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { touch.clicked(); }

    min-width: 206px;
    max-width: 206px;
    min-height: 85px;
    max-height: 85px;
    border-radius: 10px;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.active-fg : touch.pressed || touch.has-hover ? Theme.border-strong : Theme.border;
    background: touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-2 : Theme.surface;
    animate background, border-color { duration: 90ms; easing: ease-out; }
    card-layout := VerticalLayout {
        y: touch.pressed ? 1px : 0px;
        height: parent.height - self.y;
        padding: 12px;
        spacing: 7px;
        alignment: center;
        Rectangle {
            height: 20px;
            horizontal-stretch: 1;
            AppIcon {
                x: (parent.width - self.width) / 2;
                width: 20px;
                height: 20px;
                name: root.icon;
                color: Theme.muted;
            }
        }
        Text {
            text: root.text;
            color: Theme.text;
            font-size: 13px;
            horizontal-stretch: 1;
            horizontal-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component SectionLabel inherits Text {
    text: "SECTION";
    color: Theme.muted;
    font-family: "Noto Sans Mono";
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 1.4px;
    vertical-alignment: center;
}
