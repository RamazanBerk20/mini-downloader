import { DownloadRow, RowState } from "models.slint";
import { AppIcon, FileTile, IconButton, IconSlot, Theme, UiCheckBox } from "ui-kit.slint";

// One pill colour pair per row state.
global RowLook {
    pure public function bg(state: RowState) -> color {
        if state == RowState.done { return Theme.complete-bg; }
        if state == RowState.failed { return Theme.error-bg; }
        if state == RowState.paused || state == RowState.scheduled || state == RowState.interrupted { return Theme.paused-bg; }
        if state == RowState.downloading || state == RowState.engine-restarting { return Theme.active-bg; }
        return Theme.queued-bg;
    }
    pure public function fg(state: RowState) -> color {
        if state == RowState.done { return Theme.complete-fg; }
        if state == RowState.failed { return Theme.error-fg; }
        if state == RowState.paused || state == RowState.scheduled || state == RowState.interrupted { return Theme.paused-fg; }
        if state == RowState.downloading || state == RowState.engine-restarting { return Theme.active-fg; }
        return Theme.queued-fg;
    }
}

export component DownloadCard inherits Rectangle {
    in property <DownloadRow> data;
    in property <string> label-pause;
    in property <string> label-resume;
    in property <string> label-retry;
    in property <string> label-open-file;
    in property <string> label-folder;
    in property <string> label-details;
    in property <string> label-remove;
    in property <string> label-copy-url;
    callback pause(int);
    callback resume(int);
    callback retry(int);
    callback open-file(int);
    // (id, toggle): a plain click selects only this row, Ctrl/Cmd+click toggles it.
    callback row-clicked(int, bool);
    callback open-folder(int);
    callback show-details(int);
    callback remove(int);
    callback copy-url(string);
    callback toggle-selected(int, bool);
    callback key-action(int, string);
    // Drag-out: a left press arms, moves report the distance; true means the
    // OS drag started, so the press is no click.
    callback drag-pressed(int);
    callback drag-moved(int, length, length) -> bool;

    height: 94px;
    border-radius: 12px;
    border-width: 1px;
    border-color: keyboard.has-focus || root.data.selected ? Theme.strong : card-touch.has-hover ? Theme.border-strong : Theme.border;
    background: card-touch.pressed ? Theme.surface-pressed : card-touch.has-hover || root.data.selected ? Theme.surface-2 : Theme.surface;
    animate background, border-color { duration: 90ms; easing: ease-out; }

    keyboard := FocusScope {
        width: 0px;
        height: 0px;
        focus-on-tab-navigation: true;
        accessible-role: list-item;
        accessible-label: root.data.name + ", " + root.data.type-label + ", " + root.data.status-display;
        key-pressed(event) => {
            if event.text == Key.Space {
                root.key-action(root.data.id, "toggle");
                return accept;
            }
            if event.text == Key.Delete || event.text == Key.Backspace {
                root.key-action(root.data.id, "remove");
                return accept;
            }
            if event.text == Key.Return {
                root.key-action(root.data.id, "open");
                return accept;
            }
            return reject;
        }
    }

    // All pointer handling of the row lives here: click selects, double-click
    // opens a finished file (a single click never launches anything), and
    // press-and-move drags finished files out to other apps (src/dragout).
    card-touch := TouchArea {
        mouse-cursor: default;
        property <bool> toggle;
        property <bool> dragged;
        pointer-event(event) => {
            if event.kind == PointerEventKind.down && event.button == PointerEventButton.left {
                self.toggle = event.modifiers.control || event.modifiers.meta;
                self.dragged = false;
                root.drag-pressed(root.data.id);
            }
        }
        moved => {
            if self.pressed && !self.dragged {
                self.dragged = root.drag-moved(root.data.id, self.mouse-x - self.pressed-x, self.mouse-y - self.pressed-y);
            }
        }
        clicked => {
            if self.dragged { return; }
            keyboard.focus();
            root.row-clicked(root.data.id, self.toggle);
        }
        double-clicked => {
            if root.data.can-open && !self.dragged { root.open-file(root.data.id); }
        }
    }

    VerticalLayout {
        padding-top: 11px;
        padding-bottom: 10px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 7px;

        HorizontalLayout {
            spacing: 9px;
            UiCheckBox {
                checked: root.data.selected;
                label: root.data.name;
                toggled(value) => { root.toggle-selected(root.data.id, value); }
            }
            FileTile {
                type: root.data.file-type;
                label: root.data.type-label;
                count: root.data.file-count;
            }
            Text {
                text: root.data.name;
                color: Theme.strong;
                font-size: 14px;
                font-weight: 600;
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
            }
            status-pill := Rectangle {
                min-width: status-label.preferred-width + 16px;
                horizontal-stretch: 0;
                height: 20px;
                border-radius: 10px;
                background: RowLook.bg(root.data.state);
                status-label := Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: root.data.status-display.to-uppercase();
                    color: RowLook.fg(root.data.state);
                    font-family: "Noto Sans Mono";
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.surface-2;
            Rectangle {
                x: 0px;
                width: max(0px, min(parent.width, parent.width * root.data.progress));
                height: parent.height;
                horizontal-stretch: 0;
                border-radius: 3px;
                background: root.data.state == RowState.queued || root.data.state == RowState.waiting || root.data.state == RowState.removed
                    ? Theme.strong : RowLook.fg(root.data.state);
                animate width { duration: 400ms; easing: linear; }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.data.meta-text
                    + (root.data.speed-text == "" ? "" : " · " + root.data.speed-text)
                    + (root.data.eta-text == "" ? "" : " · " + root.data.eta-text);
                color: Theme.muted;
                font-family: "Noto Sans Mono";
                font-size: 10px;
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
            }
            action-rail := Rectangle {
                // HorizontalLayout.min-width already includes its own padding.
                // Adding it again left six surplus pixels on the right edge.
                min-width: action-layout.min-width;
                preferred-width: action-layout.min-width;
                horizontal-stretch: 0;
                height: 32px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                TouchArea { }
                action-layout := HorizontalLayout {
                    padding-left: 3px;
                    padding-right: 3px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    spacing: 2px;
                    if root.data.can-pause: IconButton { icon: "pause"; label: root.label-pause; width: 28px; height: 28px; clicked => { root.pause(root.data.id); } }
                    if root.data.can-resume: IconButton { icon: "play"; label: root.label-resume; width: 28px; height: 28px; clicked => { root.resume(root.data.id); } }
                    if root.data.can-retry: IconButton { icon: "retry"; label: root.label-retry; width: 28px; height: 28px; clicked => { root.retry(root.data.id); } }
                    if root.data.can-open: IconButton { icon: "folder"; label: root.label-folder; width: 28px; height: 28px; clicked => { root.open-folder(root.data.id); } }
                    IconButton { icon: "chevron-down"; label: root.label-details; width: 28px; height: 28px; clicked => { root.show-details(root.data.id); } }
                    IconButton { icon: "link"; label: root.label-copy-url; width: 28px; height: 28px; clicked => { root.copy-url(root.data.url); } }
                    IconButton { icon: "trash"; label: root.label-remove; danger: true; width: 28px; height: 28px; clicked => { root.remove(root.data.id); } }
                }
            }
        }
    }
}

// The drag image on Wayland: Rust shows it for one snapshot and crops it.
export component DragGhost inherits Rectangle {
    in property <string> name;
    in property <string> file-type;
    in property <string> type-label;
    in property <string> count;
    width: min(300px, ghost-layout.preferred-width);
    height: 40px;
    background: Theme.surface;
    border-width: 1px;
    border-color: Theme.border-strong;
    ghost-layout := HorizontalLayout {
        padding-left: 10px;
        padding-right: 12px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 9px;
        FileTile {
            type: root.file-type;
            label: root.type-label;
            count: root.count;
        }
        Text {
            text: root.name;
            color: Theme.strong;
            font-size: 13px;
            font-weight: 600;
            overflow: elide;
            vertical-alignment: center;
        }
    }
}

export component PackageHeader inherits Rectangle {
    in property <DownloadRow> data;
    in property <string> label-pause;
    in property <string> label-resume;
    in property <string> label-remove;
    in property <string> label-collapse;
    in property <string> label-expand;
    callback toggle(int);
    callback action(int, string);

    height: 66px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border-strong;
    background: Theme.surface-2;

    IconButton {
        x: 9px;
        y: 8px;
        icon: root.data.package-collapsed ? "chevron-right" : "chevron-down";
        label: root.data.package-collapsed ? root.label-expand : root.label-collapse;
        clicked => { root.toggle(root.data.package-id); }
    }
    Text {
        x: 48px;
        y: 8px;
        width: parent.width - 200px;
        height: 20px;
        text: root.data.package-name;
        color: Theme.strong;
        font-size: 13px;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
    }
    Text {
        x: 48px;
        y: 29px;
        width: parent.width - 200px;
        height: 18px;
        text: root.data.package-count-text + " · " + root.data.package-meta-text;
        color: Theme.muted;
        font-family: "Noto Sans Mono";
        font-size: 9px;
        overflow: elide;
        vertical-alignment: center;
    }
    Rectangle {
        x: 48px;
        y: 51px;
        width: parent.width - 62px;
        height: 4px;
        border-radius: 2px;
        background: Theme.border;
        Rectangle {
            x: 0px;
            width: max(0px, min(parent.width, parent.width * root.data.package-progress));
            height: parent.height;
            horizontal-stretch: 0;
            border-radius: 2px;
            background: Theme.active-fg;
            animate width { duration: 400ms; easing: linear; }
        }
    }
    if root.data.package-running: IconButton {
        x: parent.width - 104px;
        y: 8px;
        width: 28px;
        height: 28px;
        icon: "pause";
        label: root.label-pause;
        clicked => { root.action(root.data.package-id, "pause"); }
    }
    if root.data.package-resumable: IconButton {
        x: parent.width - 72px;
        y: 8px;
        width: 28px;
        height: 28px;
        icon: "play";
        label: root.label-resume;
        clicked => { root.action(root.data.package-id, "resume"); }
    }
    IconButton {
        x: parent.width - 40px;
        y: 8px;
        width: 28px;
        height: 28px;
        icon: "trash";
        danger: true;
        label: root.label-remove;
        clicked => { root.action(root.data.package-id, "remove"); }
    }
}
