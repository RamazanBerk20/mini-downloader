    in property <string> label-firefox-hint: "Firefox, Firefox ESR, LibreWolf, Waterfox, Zen, and similar browsers.";
    in property <string> label-chromium-hint: "Chrome, Chromium, Edge, Brave, Vivaldi, Opera, and similar browsers.";
