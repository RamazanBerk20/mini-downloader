    in property <string> label-detail-peers: "Peers";
    in property <string> label-detail-pieces: "Pieces";
    in property <string> label-detail-folder: "Folder";
    in property <string> label-apply-selection: "Apply selection";
    in property <string> label-speed-limit: "Speed limit";
    in property <string> label-apply: "Apply";
