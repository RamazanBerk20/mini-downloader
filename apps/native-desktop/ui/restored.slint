import { ComboBox, Palette, ScrollView, SpinBox } from "std-widgets.slint";
import { AppIcon, IconButton, IconSlot, NavItem, OnboardCard, SectionLabel, SettingsTab, Theme, UiButton, UiCheckBox, UiDecimalField, UiField, UiNumberField, UiSlider, UiStepper, UiSwitch, UiTextArea } from "ui-kit.slint";

export struct DownloadRow {
    id: int,
    name: string,
    url: string,
    kind: string,
    status: string,
    status-display: string,
    progress: float,
    progress-text: string,
    speed-text: string,
    meta-text: string,
    running: bool,
    resumable: bool,
    selected: bool,
    package-id: int,
    package-name: string,
    package-first: bool,
    package-collapsed: bool,
    package-count-text: string,
    package-progress: float,
    package-meta-text: string,
    package-running: bool,
    package-resumable: bool,
}

export struct CategoryRow {
    id: int,
    name: string,
    dir: string,
    rules: string,
    priority: int,
    count: int,
}

export struct ScheduleRow {
    id: int,
    name: string,
    summary: string,
    action: string,
    days: int,
    minute: int,
    speed: int,
    enabled: bool,
}

export struct LinkChoice {
    url: string,
    kind: string,
    host: string,
    selected: bool,
}

export struct MediaChoice {
    url: string,
    format-id: string,
    title: string,
    label: string,
    selected: bool,
    playlist: bool,
}

export struct DetailFileRow {
    index: int,
    name: string,
    progress: float,
    meta: string,
    selected: bool,
}

component DownloadCard inherits Rectangle {
    in property <DownloadRow> data;
    in property <string> label-pause;
    in property <string> label-resume;
    in property <string> label-retry;
    in property <string> label-open-file;
    in property <string> label-folder;
    in property <string> label-details;
    in property <string> label-remove;
    in property <string> label-copy-url;
    callback pause(int);
    callback resume(int);
    callback retry(int);
    callback open-file(int);
    callback open-folder(int);
    callback show-details(int);
    callback remove(int);
    callback copy-url(string);
    callback toggle-selected(int, bool);
    callback key-action(int, string);

    height: 94px;
    border-radius: 12px;
    border-width: 1px;
    border-color: keyboard.has-focus ? Theme.strong : card-touch.has-hover ? Theme.border-strong : Theme.border;
    background: card-touch.pressed ? Theme.surface-pressed : card-touch.has-hover ? Theme.surface-2 : Theme.surface;
    animate background, border-color { duration: 90ms; easing: ease-out; }

    keyboard := FocusScope {
        width: 0px;
        height: 0px;
        focus-on-tab-navigation: true;
        accessible-role: list-item;
        accessible-label: root.data.name;
        key-pressed(event) => {
            if event.text == Key.Space {
                root.key-action(root.data.id, "toggle");
                return accept;
            }
            if event.text == Key.Delete || event.text == Key.Backspace {
                root.key-action(root.data.id, "remove");
                return accept;
            }
            if event.text == Key.Return {
                root.key-action(root.data.id, "open");
                return accept;
            }
            return reject;
        }
    }

    card-touch := TouchArea {
        enabled: root.data.status == "complete";
        mouse-cursor: pointer;
        clicked => { root.open-file(root.data.id); }
    }

    VerticalLayout {
        padding-top: 11px;
        padding-bottom: 10px;
        padding-left: 14px;
        padding-right: 14px;
        spacing: 7px;

        HorizontalLayout {
            spacing: 9px;
            UiCheckBox {
                checked: root.data.selected;
                label: root.data.name;
                toggled(value) => { root.toggle-selected(root.data.id, value); }
            }
            IconSlot {
                name: root.data.kind == "video" || root.data.kind == "hls" || root.data.kind == "dash" ? "video" :
                    root.data.kind == "magnet" || root.data.kind == "torrent" ? "magnet" : "file";
                size: 16px;
                icon-color: Theme.muted;
            }
            Text {
                text: root.data.name;
                color: Theme.strong;
                font-size: 14px;
                font-weight: 600;
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
            }
            status-pill := Rectangle {
                min-width: status-label.preferred-width + 16px;
                horizontal-stretch: 0;
                height: 20px;
                border-radius: 10px;
                background: root.data.status == "complete" ? Theme.complete-bg :
                    root.data.status == "error" ? Theme.error-bg :
                    root.data.status == "paused" || root.data.status == "scheduled" ? Theme.paused-bg :
                    root.data.running ? Theme.active-bg : Theme.queued-bg;
                status-label := Text {
                    x: 8px;
                    width: parent.width - 16px;
                    height: parent.height;
                    text: root.data.status-display.to-uppercase();
                    color: root.data.status == "complete" ? Theme.complete-fg :
                        root.data.status == "error" ? Theme.error-fg :
                        root.data.status == "paused" || root.data.status == "scheduled" ? Theme.paused-fg :
                        root.data.running ? Theme.active-fg : Theme.queued-fg;
                    font-family: "Noto Sans Mono";
                    font-size: 9px;
                    font-weight: 600;
                    letter-spacing: 0.5px;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }

        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: Theme.surface-2;
            Rectangle {
                x: 0px;
                width: max(0px, min(parent.width, parent.width * root.data.progress));
                height: parent.height;
                horizontal-stretch: 0;
                border-radius: 3px;
                background: root.data.status == "complete" ? Theme.complete-fg :
                    root.data.status == "error" ? Theme.error-fg :
                    root.data.status == "paused" || root.data.status == "scheduled" ? Theme.paused-fg :
                    root.data.running ? Theme.active-fg : Theme.strong;
                animate width { duration: 400ms; easing: linear; }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.data.meta-text + (root.data.speed-text == "" ? "" : " · " + root.data.speed-text);
                color: Theme.muted;
                font-family: "Noto Sans Mono";
                font-size: 10px;
                horizontal-stretch: 1;
                overflow: elide;
                vertical-alignment: center;
            }
            action-rail := Rectangle {
                // HorizontalLayout.min-width already includes its own padding.
                // Adding it again left six surplus pixels on the right edge.
                min-width: action-layout.min-width;
                preferred-width: action-layout.min-width;
                horizontal-stretch: 0;
                height: 32px;
                border-radius: 8px;
                border-width: 1px;
                border-color: Theme.border;
                background: Theme.surface;
                TouchArea { }
                action-layout := HorizontalLayout {
                    padding-left: 3px;
                    padding-right: 3px;
                    padding-top: 2px;
                    padding-bottom: 2px;
                    spacing: 2px;
                    if root.data.running: IconButton { icon: "pause"; label: root.label-pause; width: 28px; height: 28px; clicked => { root.pause(root.data.id); } }
                    if root.data.resumable: IconButton { icon: "play"; label: root.label-resume; width: 28px; height: 28px; clicked => { root.resume(root.data.id); } }
                    if root.data.status == "error": IconButton { icon: "retry"; label: root.label-retry; width: 28px; height: 28px; clicked => { root.retry(root.data.id); } }
                    if root.data.status == "complete": IconButton { icon: "folder"; label: root.label-folder; width: 28px; height: 28px; clicked => { root.open-folder(root.data.id); } }
                    IconButton { icon: "chevron-down"; label: root.label-details; width: 28px; height: 28px; clicked => { root.show-details(root.data.id); } }
                    IconButton { icon: "link"; label: root.label-copy-url; width: 28px; height: 28px; clicked => { root.copy-url(root.data.url); } }
                    IconButton { icon: "trash"; label: root.label-remove; danger: true; width: 28px; height: 28px; clicked => { root.remove(root.data.id); } }
                }
            }
        }
    }
}

component PackageHeader inherits Rectangle {
    in property <DownloadRow> data;
    in property <string> label-pause;
    in property <string> label-resume;
    in property <string> label-remove;
    in property <string> label-collapse;
    in property <string> label-expand;
    callback toggle(int);
    callback action(int, string);

    height: 66px;
    border-radius: 10px;
    border-width: 1px;
    border-color: Theme.border-strong;
    background: Theme.surface-2;

    IconButton {
        x: 9px;
        y: 8px;
        icon: root.data.package-collapsed ? "chevron-right" : "chevron-down";
        label: root.data.package-collapsed ? root.label-expand : root.label-collapse;
        clicked => { root.toggle(root.data.package-id); }
    }
    Text {
        x: 48px;
        y: 8px;
        width: parent.width - 200px;
        height: 20px;
        text: root.data.package-name;
        color: Theme.strong;
        font-size: 13px;
        font-weight: 700;
        overflow: elide;
        vertical-alignment: center;
    }
    Text {
        x: 48px;
        y: 29px;
        width: parent.width - 200px;
        height: 18px;
        text: root.data.package-count-text + " · " + root.data.package-meta-text;
        color: Theme.muted;
        font-family: "Noto Sans Mono";
        font-size: 9px;
        overflow: elide;
        vertical-alignment: center;
    }
    Rectangle {
        x: 48px;
        y: 51px;
        width: parent.width - 62px;
        height: 4px;
        border-radius: 2px;
        background: Theme.border;
        Rectangle {
            x: 0px;
            width: max(0px, min(parent.width, parent.width * root.data.package-progress));
            height: parent.height;
            horizontal-stretch: 0;
            border-radius: 2px;
            background: Theme.active-fg;
            animate width { duration: 400ms; easing: linear; }
        }
    }
    if root.data.package-running: IconButton {
        x: parent.width - 104px;
        y: 8px;
        width: 28px;
        height: 28px;
        icon: "pause";
        label: root.label-pause;
        clicked => { root.action(root.data.package-id, "pause"); }
    }
    if root.data.package-resumable: IconButton {
        x: parent.width - 72px;
        y: 8px;
        width: 28px;
        height: 28px;
        icon: "play";
        label: root.label-resume;
        clicked => { root.action(root.data.package-id, "resume"); }
    }
    IconButton {
        x: parent.width - 40px;
        y: 8px;
        width: 28px;
        height: 28px;
        icon: "trash";
        danger: true;
        label: root.label-remove;
        clicked => { root.action(root.data.package-id, "remove"); }
    }
}

component SettingsToggleRow inherits Rectangle {
    in property <string> text;
    in-out property <bool> checked: false;
    callback changed(bool);

    height: 48px;
    horizontal-stretch: 1;
    background: transparent;
    Text {
        x: 0px;
        width: parent.width - 58px;
        height: parent.height;
        text: root.text;
        color: Theme.text;
        font-size: 13px;
        vertical-alignment: center;
        overflow: elide;
    }
    UiSwitch {
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        checked <=> root.checked;
        label: root.text;
        toggled(value) => { root.changed(value); }
    }
}

component SettingsHint inherits Text {
    in property <string> value: "";
    text: root.value;
    color: Theme.muted;
    font-size: 11px;
    wrap: word-wrap;
    vertical-alignment: top;
    min-height: self.preferred-height;
}

component DayChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected: false;
    callback clicked;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-checked: root.selected;
    accessible-action-default => { touch.clicked(); }

    height: 29px;
    min-width: 39px;
    horizontal-stretch: 1;
    vertical-stretch: 0;
    border-radius: 6px;
    border-width: focus.has-focus ? 2px : 1px;
    border-color: focus.has-focus ? Theme.active-fg : root.selected ? (touch.pressed ? Theme.ink-pressed : touch.has-hover ? Theme.ink-hover : Theme.ink) :
        touch.pressed ? Theme.border-strong : Theme.border;
    background: root.selected ? (touch.pressed ? Theme.ink-pressed : touch.has-hover ? Theme.ink-hover : Theme.ink) :
        touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-2 : Theme.surface;
    animate background, border-color { duration: 90ms; easing: ease-out; }
    Text {
        x: 4px;
        y: touch.pressed ? 1px : 0px;
        width: parent.width - 8px;
        height: parent.height - self.y;
        text: root.text;
        color: root.selected ? Theme.ink-fg : Theme.text;
        font-family: "Noto Sans Mono";
        font-size: 10px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component BrowserStatus inherits Rectangle {
    in property <string> text;
    in property <int> state: 0;

    height: 22px;
    width: label.preferred-width + 14px;
    horizontal-stretch: 0;
    vertical-stretch: 0;
    border-radius: 11px;
    border-width: 1px;
    border-color: root.state == 1 ? Theme.complete-fg : root.state == 2 ? Theme.active-fg : root.state == 3 ? Theme.paused-fg : Theme.border;
    background: root.state == 1 ? Theme.complete-bg : root.state == 2 ? Theme.active-bg : root.state == 3 ? Theme.paused-bg : Theme.surface-2;
    label := Text {
        x: 7px;
        width: parent.width - 14px;
        height: parent.height;
        text: root.text;
        color: root.state == 1 ? Theme.complete-fg : root.state == 2 ? Theme.active-fg : root.state == 3 ? Theme.paused-fg : Theme.muted;
        font-size: 10px;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component BrowserStoreCard inherits Rectangle {
    in property <string> browser;
    in property <string> status-text;
    in property <int> status-state: 0;
    in property <string> hint;
    in property <string> button-text;
    callback install();

    height: 82px;
    border-radius: 7px;
    border-width: 1px;
    border-color: Theme.border;
    background: Theme.surface;

    Text {
        x: 12px;
        y: 9px;
        width: 72px;
        height: 24px;
        text: root.browser;
        color: Theme.strong;
        font-size: 13px;
        font-weight: 600;
        vertical-alignment: center;
    }
    BrowserStatus {
        x: 86px;
        y: 10px;
        state: root.status-state;
        text: root.status-text;
    }
    Text {
        x: 12px;
        y: 37px;
        width: parent.width - install-button.width - 34px;
        height: 35px;
        text: root.hint;
        color: Theme.muted;
        font-size: 10px;
        wrap: word-wrap;
        vertical-alignment: top;
    }
    install-button := UiButton {
        x: parent.width - self.width - 10px;
        y: 24px;
        width: min(164px, parent.width - 20px);
        text: root.button-text;
        icon: "link";
        primary: true;
        compact: true;
        clicked => { root.install(); }
    }
}

component SponsorButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { touch.clicked(); }

    width: label.preferred-width + 43px;
    height: 38px;
    border-radius: 6px;
    border-width: focus.has-focus ? 2px : 0px;
    border-color: Theme.active-fg;
    background: touch.pressed ? Theme.surface-pressed : touch.has-hover ? Theme.surface-2 : transparent;
    animate background { duration: 90ms; easing: ease-out; }

    AppIcon {
        x: 9px;
        y: (parent.height - self.height) / 2 + (touch.pressed ? 1px : 0px);
        width: 16px;
        height: 16px;
        name: "heart";
        color: Theme.dark ? #c9788d : #b0526b;
    }
    label := Text {
        x: 32px;
        y: touch.pressed ? 1px : 0px;
        width: self.preferred-width;
        height: parent.height - self.y;
        text: root.text;
        color: touch.has-hover ? Theme.text : Theme.muted;
        font-size: 12px;
        font-weight: 500;
        vertical-alignment: center;
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == Key.Space || event.text == Key.Return {
                touch.clicked();
                return accept;
            }
            return reject;
        }
    }
}

export component MainWindow inherits Window {
    title: "Mini Downloader";
    icon: @image-url("../../desktop/src-tauri/icons/32x32.png");
    preferred-width: 1000px;
    preferred-height: 680px;
    min-width: 720px;
    min-height: 480px;
    default-font-family: "Noto Sans";
    default-font-size: 14px;
    background: Theme.canvas;

    in property <[DownloadRow]> downloads;
    in property <[CategoryRow]> categories;
    in property <[ScheduleRow]> schedules;
    in property <[LinkChoice]> grabbed-links;
    in property <[MediaChoice]> media-choices;
    in property <[DetailFileRow]> detail-files;
    in-out property <string> page-title: "All downloads";
    in property <string> status-text: "";
    in property <string> memory-text: "";
    in property <int> count-all: 0;
    in property <int> count-active: 0;
    in property <int> count-paused: 0;
    in property <int> count-scheduled: 0;
    in property <int> count-completed: 0;
    in property <int> count-failed: 0;
    in property <int> selected-count: 0;
    in property <string> selected-text: "";
    in-out property <string> url-text: "";
    in-out property <string> search-text: "";
    in-out property <string> checksum-text: "";
    in-out property <bool> show-add-options: false;
    in-out property <int> global-speed-index: 0;
    in-out property <string> link-text: "";
    in-out property <string> link-package: "";
    in-out property <string> media-url: "";
    in-out property <string> media-title: "";
    in-out property <string> media-entries-text: "";
    in-out property <bool> media-is-playlist: false;
    in-out property <bool> media-probe-playlist: false;
    in-out property <string> media-quality: "best";
    in-out property <bool> media-audio-only: false;
    in-out property <bool> media-subtitles: false;
    in-out property <bool> media-embed-subtitles: false;
    in-out property <string> media-sub-langs: "en";
    in-out property <string> media-audio-format: "mp3";
    in-out property <bool> media-thumbnail: false;
    in-out property <string> proxy-text: "";
    in-out property <int> max-concurrent: 5;
    in-out property <int> split-count: 16;
    in-out property <int> connection-count: 16;
    in-out property <bool> clipboard-watch: false;
    in-out property <bool> auto-organize: true;
    in-out property <bool> prevent-duplicates: true;
    in-out property <bool> close-to-tray: true;
    in-out property <bool> autostart: false;
    in-out property <bool> handle-magnets: true;
    in-out property <bool> dht-enabled: true;
    in-out property <bool> sandbox-children: false;
    in-out property <bool> block-private-ips: true;
    in-out property <string> locale-choice: "System Default";
    in-out property <string> on-complete-action: "none";
    in-out property <string> on-complete-command: "";
    in-out property <bool> on-complete-confirmed: false;
    in-out property <float> default-speed-mb: 0;
    in-out property <string> update-text: "";
    in-out property <string> update-page: "";
    in-out property <string> update-asset: "";
    in-out property <string> connector-text: "";
    in-out property <string> theme-choice: "system";
    in property <bool> system-dark: true;
    in property <bool> rtl: false;
    in property <bool> dark: root.theme-choice == "dark" || (root.theme-choice == "system" && root.system-dark);
    in-out property <int> firefox-state: 0;
    in-out property <int> chromium-state: 0;
    in-out property <int> current-page: 0;
    in-out property <int> settings-section: 0;
    in-out property <int> status-filter: 0;
    in-out property <bool> detail-visible: false;
    in-out property <string> detail-url: "";
    in-out property <string> detail-dir: "";
    in-out property <string> detail-error: "";
    in-out property <int> detail-peer-count: 0;
    in-out property <string> detail-pieces-text: "";
    in-out property <int> detail-id: 0;
    in-out property <bool> detail-is-torrent: false;
    in-out property <int> detail-speed-kb: 0;
    in-out property <int> detail-delay-minutes: 10;
    in-out property <int> delete-confirm-id: 0;
    in-out property <string> category-name: "";
    in-out property <string> category-dir: "";
    in-out property <string> category-rules: "";
    in-out property <string> category-mime: "";
    in-out property <string> category-host: "";
    in-out property <string> schedule-name: "";
    in-out property <int> schedule-id: 0;
    in-out property <string> schedule-action: "pause_all";
    in-out property <int> schedule-hour: 22;
    in-out property <int> schedule-minute: 0;
    in-out property <int> schedule-days: 127;
    in-out property <int> schedule-speed: 512000;
    out property <bool> shortcut-blocked: root.current-page != 0 || root.detail-visible || add-field.input-focused || search-field.input-focused;

    in property <string> nav-downloads: "All downloads";
    in property <string> nav-links: "Grab links";
    in property <string> nav-media: "Grab video";
    in property <string> nav-settings: "Settings";
    in property <string> label-filters: "STATUS";
    in property <string> label-categories: "CATEGORIES";
    in property <string> label-all: "All";
    in property <string> label-active: "Active";
    in property <string> label-paused: "Paused";
    in property <string> label-scheduled: "Scheduled";
    in property <string> label-completed: "Completed";
    in property <string> label-failed: "Failed";
    in property <string> label-pause-all: "Pause all";
    in property <string> label-resume-all: "Resume all";
    in property <string> label-clear-completed: "Clear completed";
    in property <string> label-clear-failed: "Clear failed";
    in property <string> label-search: "Search";
    in property <string> label-add-placeholder: "Paste a URL or magnet link";
    in property <string> label-checksum: "SHA-256 checksum (optional)";
    in property <string> label-add: "Add";
    in property <string> label-pause: "Pause";
    in property <string> label-resume: "Resume";
    in property <string> label-retry: "Retry";
    in property <string> label-open-file: "Open file";
    in property <string> label-folder: "Open folder";
    in property <string> label-details: "Details";
    in property <string> label-remove: "Remove";
    in property <string> label-remove-delete: "Remove + delete files";
    in property <string> label-confirm-delete: "Confirm: delete files";
    in property <string> label-copy-url: "Copy URL";
    in property <string> label-close: "Close";
    in property <string> label-empty-title: "No downloads yet";
    in property <string> label-empty-sub: "Paste a URL above, or capture one from your browser.";
    in property <string> label-no-match-title: "No matching downloads";
    in property <string> label-no-match-sub: "Try another filter or search.";
    in property <string> label-onboard-paste: "Paste a URL";
